GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PORT=8787

# Firebase Authentication (Firebase console → Project settings → Your apps → Web app config).
# The server uses VITE_FIREBASE_PROJECT_ID to verify sign-ins; when it is unset, /api/run is unprotected.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
